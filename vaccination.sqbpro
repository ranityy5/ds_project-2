dex="3" value="124"/><column index="4" value="92"/><column index="5" value="92"/><column index="6" value="93"/><column index="7" value="87"/><column index="8" value="161"/><column index="9" value="126"/><column index="10" value="83"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT g.year, g.antigen_code, g.coverage_pct
FROM fact_coverage_group g
WHERE g.group_type = 'GLOBAL' AND g.category_code = 'WUENIC'
  AND g.antigen_code IN ('DTPCV3','MCV1','MCV2','POL3','PCV3','ROTAC') AND g.year &gt;= 2000
ORDER BY g.antigen_code, g.year;</sql><current_tab id="0"/></tab_sql></sqlb_project>
